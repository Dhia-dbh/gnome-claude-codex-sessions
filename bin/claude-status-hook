#!/usr/bin/env bash
# Claude Code / Codex hook: records each session's state for the "Claude & Codex Sessions" top-bar extension.
# Claude Code: wired in the settings.json of every account (~/.claude-personal, ~/.claude-work) for
# SessionStart, UserPromptSubmit, PostToolUse, Stop, StopFailure (rate_limit only), Notification
# (permission/question only) and SessionEnd.
# Codex: run as `claude-status-hook --agent codex`, wired in the hooks.json of every Codex home (~/.codex,
# ~/.codex-work) for SessionStart, UserPromptSubmit, PostToolUse, PermissionRequest, Stop, Interrupt and
# SessionEnd.
# The account is the config dir's name: ~/.claude-work -> "work", ~/.claude -> "default" (CLAUDE_CONFIG_DIR);
# for Codex the same with ~/.codex (CODEX_HOME).
# Status files: ~/.cache/claude-status/<session_id>.json, with the agent and the claude / codex process's
# pid + start time so the extension can tell a live session from one that was killed. No pop-ups (removed
# 2026-11-16).
set -u
agent=claude
[ "${1:-}" = --agent ] && agent=${2:-claude}
dir="${XDG_CACHE_HOME:-$HOME/.cache}/claude-status"
mkdir -p "$dir"
input=$(cat)
field() { printf '%s' "$input" | jq -r "$1 // empty" 2>/dev/null; }
session=$(field .session_id)
event=$(field .hook_event_name)
cwd=$(field .cwd)
[ -n "$session" ] || exit 0
file="$dir/$session.json"

case "$agent:$event" in
  *:SessionStart) state=idle ;;
  *:UserPromptSubmit) state=working ;;
  *:PostToolUse)   # a tool ran, so any permission prompt was answered; skip the write when nothing changed
    [ "$(jq -r '.state // empty' "$file" 2>/dev/null)" = working ] && exit 0
    state=working ;;
  *:Stop) state=done ;;
  claude:StopFailure)   # the turn died on an API error; only a usage/rate limit gets its own state
    [ "$(field .error)" = rate_limit ] || exit 0
    state=limited ;;
  claude:Notification|codex:PermissionRequest) state=waiting ;;
  codex:Interrupt) state=idle ;;
  *:SessionEnd) rm -f "$file" "$dir/muted/$session"; exit 0 ;;
  *) exit 0 ;;
esac

# what a waiting session asks: Claude's notification text, or the tool Codex wants to run
if [ "$agent" = codex ]; then
  message=$(printf '%s' "$input" | jq -r '(.tool_input.description // (.tool_name + ": " +
    (.tool_input.command // "" | if type == "array" then join(" ") else tostring end))) // empty
    | split("\n")[0][0:200]' 2>/dev/null)
  config="${CODEX_HOME:-$HOME/.codex}"
else
  message=$(field .message)
  config="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
fi
account=$(basename "$config"); account=${account#.$agent}; account=${account#-}
account=${account:-default}

# the claude / codex process this hook runs under: walk up the parents
pid=$PPID
while [ "$pid" -gt 1 ] && [ "$(cat /proc/$pid/comm 2>/dev/null)" != "$agent" ]; do
  pid=$(awk '{print $4}' /proc/$pid/stat 2>/dev/null || echo 1)
done
pidstart=0
if [ "$pid" -gt 1 ]; then pidstart=$(awk '{print $22}' /proc/$pid/stat); else pid=0; fi

started=$(jq -r '.started // empty' "$file" 2>/dev/null)
now=$(date +%s)
jq -n --arg session "$session" --arg agent "$agent" --arg state "$state" --arg project "$(basename "${cwd:-unknown}")" \
      --arg cwd "$cwd" --arg account "$account" --arg message "$message" \
      --argjson pid "$pid" --argjson pidstart "$pidstart" --argjson updated "$now" --argjson started "${started:-$now}" \
      '{session: $session, agent: $agent, account: $account, state: $state, project: $project, cwd: $cwd,
        message: $message, pid: $pid, pidstart: $pidstart, updated: $updated, started: $started}' > "$file.tmp" && mv "$file.tmp" "$file"
# Codex reads Stop and Interrupt output as JSON: plain text or nothing is an invalid result
[ "$agent" = codex ] && case "$event" in Stop|Interrupt) echo '{}' ;; esac
exit 0
