#!/usr/bin/env bash
# Claude Code hook: records each session's state for the "Claude Sessions" top-bar extension.
# Wired in the settings.json of every account (~/.claude-personal, ~/.claude-work) for SessionStart,
# UserPromptSubmit, PostToolUse, Stop, StopFailure (rate_limit only), Notification (permission/question only)
# and SessionEnd.
# The account is the config dir's name: ~/.claude-work -> "work", ~/.claude -> "default".
# Status files: ~/.cache/claude-status/<session_id>.json, with the claude process's pid + start time so
# the extension can tell a live session from one that was killed. No pop-ups (removed 2026-11-16).
set -u
dir="${XDG_CACHE_HOME:-$HOME/.cache}/claude-status"
mkdir -p "$dir"
input=$(cat)
field() { printf '%s' "$input" | jq -r "$1 // empty" 2>/dev/null; }
session=$(field .session_id)
event=$(field .hook_event_name)
cwd=$(field .cwd)
[ -n "$session" ] || exit 0
file="$dir/$session.json"

case "$event" in
  SessionStart) state=idle ;;
  UserPromptSubmit) state=working ;;
  PostToolUse)   # a tool ran, so any permission prompt was answered; skip the write when nothing changed
    [ "$(jq -r '.state // empty' "$file" 2>/dev/null)" = working ] && exit 0
    state=working ;;
  Stop) state=done ;;
  StopFailure)   # the turn died on an API error; only a usage/rate limit gets its own state
    [ "$(field .error)" = rate_limit ] || exit 0
    state=limited ;;
  Notification) state=waiting ;;
  SessionEnd) rm -f "$file" "$dir/muted/$session"; exit 0 ;;
  *) exit 0 ;;
esac

config="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
account=$(basename "$config"); account=${account#.claude}; account=${account#-}
account=${account:-default}

# the claude process this hook runs under: walk up the parents
pid=$PPID
while [ "$pid" -gt 1 ] && [ "$(cat /proc/$pid/comm 2>/dev/null)" != claude ]; do
  pid=$(awk '{print $4}' /proc/$pid/stat 2>/dev/null || echo 1)
done
pidstart=0
if [ "$pid" -gt 1 ]; then pidstart=$(awk '{print $22}' /proc/$pid/stat); else pid=0; fi

started=$(jq -r '.started // empty' "$file" 2>/dev/null)
now=$(date +%s)
jq -n --arg session "$session" --arg state "$state" --arg project "$(basename "${cwd:-unknown}")" \
      --arg cwd "$cwd" --arg account "$account" --arg message "$(field .message)" \
      --argjson pid "$pid" --argjson pidstart "$pidstart" --argjson updated "$now" --argjson started "${started:-$now}" \
      '{session: $session, account: $account, state: $state, project: $project, cwd: $cwd, message: $message,
        pid: $pid, pidstart: $pidstart, updated: $updated, started: $started}' > "$file.tmp" && mv "$file.tmp" "$file"
exit 0
